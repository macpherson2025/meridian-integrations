---
// Hero.astro Component Script
---

<section class="relative w-full bg-[var(--color-background)] pt-24 pb-16 md:pt-32 md:pb-24 border-b border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-6 md:px-12">
    <div class="max-w-3xl mb-16 md:mb-24">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-6 leading-tight">
        Invisible Technology.<br class="hidden md:inline"/> Flawless Aesthetics.
      </h1>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] font-normal leading-relaxed">
        Meridian Integrations engineers high-performance networking, structural security, and automation infrastructure designed to vanish into your architecture. Zero visual footprint. Absolute control.
      </p>
    </div>

    <div class="mt-12">
      <div class="mb-12 border-b border-[var(--color-border)] pb-4">
        <h2 class="text-xs font-bold tracking-widest text-[var(--color-accent)] uppercase">
          Three Practices. One Property.
        </h2>
        <p class="text-sm text-[var(--color-text-muted)] mt-1">
          Critical components engineered as a single, unified structure.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
        <!-- Practice 01: Infrastructure -->
        <div class="flex flex-col justify-between h-full group">
          <div>
            <span class="text-xs font-semibold text-[var(--color-taupe)] uppercase tracking-wider block mb-2">Practice 01</span>
            <h3 class="text-xl font-bold text-[var(--color-text)] mb-3">Network & Security</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
              Enterprise-grade Wi-Fi, UniFi Protect surveillance, next-generation network security, and high-speed wireless links for outbuildings. High-capacity performance deployed with a zero-hardware visual footprint.
            </p>
          </div>
          <a href="/unifi-networking/" class="text-xs font-bold text-[var(--color-accent)] no-underline group-hover:text-[var(--color-accent-bright)] transition-colors duration-200 inline-flex items-center gap-1 uppercase tracking-wider">
            Explore Infrastructure &rarr;
          </a>
        </div>

        <!-- Practice 02: Automation -->
        <div class="flex flex-col justify-between h-full group">
          <div>
            <span class="text-xs font-semibold text-[var(--color-taupe)] uppercase tracking-wider block mb-2">Practice 02</span>
            <h3 class="text-xl font-bold text-[var(--color-text)] mb-3">Architectural Lighting</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
              Lutron lighting controls, color-temperature engineering calibrated in Kelvin, and silent motorized shading treatments. Dynamic environments designed to vanish completely into your interior styling.
            </p>
          </div>
          <a href="/lutron-lighting/" class="text-xs font-bold text-[var(--color-accent)] no-underline group-hover:text-[var(--color-accent-bright)] transition-colors duration-200 inline-flex items-center gap-1 uppercase tracking-wider">
            Explore Systems &rarr;
          </a>
        </div>

        <!-- Practice 03: Automation -->
        <div class="flex flex-col justify-between h-full group">
          <div>
            <span class="text-xs font-semibold text-[var(--color-taupe)] uppercase tracking-wider block mb-2">Practice 03</span>
            <h3 class="text-xl font-bold text-[var(--color-text)] mb-3">Smart Home Solutions</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
              Lutron lighting controls and silent motorized shades integrated seamlessly with your interior architecture. Advanced automation engineered to replace wall clutter with clean, unified control panels.
            </p>
          </div>
          <a href="/smart-home-automation/" class="text-xs font-bold text-[var(--color-accent)] no-underline group-hover:text-[var(--color-accent-bright)] transition-colors duration-200 inline-flex items-center gap-1 uppercase tracking-wider">
            Explore Automation &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
