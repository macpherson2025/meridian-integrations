---
// Footer.astro - Global Structural NAP Module
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[var(--color-background)] border-t border-[var(--color-border)] pt-16 pb-12 mt-auto">
  <div class="max-w-6xl mx-auto px-6 md:px-12">
    
    <!-- Upper Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8 mb-16">
      
      
      <div class="md:col-span-2 space-y-4">
        <span class="text-xs font-bold tracking-widest text-[var(--color-text)] uppercase block">
          Meridian Integrations
        </span>
        <p class="text-xs text-[var(--color-text-muted)] leading-relaxed max-w-sm">
          Engineering invisible low-voltage infrastructure, enterprise networking, and premium environmental automation systems tailored for architectural preservation.
        </p>
      </div>

      <!-- Column 2: Service Architecture Links -->
      <div class="space-y-3">
        <span class="text-[10px] font-bold text-[var(--color-taupe)] uppercase tracking-widest block">Systems</span>
        <ul class="space-y-2 text-xs">
          <li><a href="/unifi-networking" class="text-[var(--color-text-muted)] no-underline hover:text-[var(--color-accent)] transition-colors duration-200">Network & Security</a></li>
          <li><a href="/lutron-lighting" class="text-[var(--color-text-muted)] no-underline hover:text-[var(--color-accent)] transition-colors duration-200">Architectural Lighting</a></li>
          <li><a href="/trade-partners" class="text-[var(--color-text-muted)] no-underline hover:text-[var(--color-accent)] transition-colors duration-200">Trade Partnerships</a></li>
        </ul>
      </div>

      <!-- Column 3: Corporate NAP Credentials -->
      <div class="space-y-3">
        <span class="text-[10px] font-bold text-[var(--color-taupe)] uppercase tracking-widest block">Intake</span>
        <ul class="space-y-2 text-xs text-[var(--color-text-muted)]">
          <li><a href="/contact" class="no-underline hover:text-[var(--color-accent)] transition-colors duration-200">Request Consultation</a></li>
          <li class="pt-1 font-mono text-[11px] text-[var(--color-text)]">P: 720-989-9807</li>
          <li class="font-mono text-[11px]">H: Mon - Fri / 08:00 - 17:00</li>
        </ul>
      </div>

    </div>

    <!-- Lower Operational Footer Anchor -->
    <div class="border-t border-[var(--color-border)] pt-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <p class="text-[11px] text-[var(--color-text-muted)] tracking-wide">
        &copy; {currentYear} Meridian Integrations LLC. All rights reserved.
      </p>
      <div class="flex gap-6 text-[11px] text-[var(--color-text-muted)]">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--color-accent)]">Denver Region Integration Asset</span>
      </div>
    </div>

  </div>
</footer>
