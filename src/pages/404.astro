---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'That address is not part of the Meridian Integrations website.';
---

<BaseLayout title="Page not found" description={description} noindex>
	<section class="empty">
		<div class="wrap">
			<p class="eyebrow">404</p>
			<h1>That address is not on this site.</h1>
			<p class="lede">The page may have moved, or the link may have been mistyped.</p>
			<div class="cluster">
				<a class="btn btn-primary" href="/">Back to the home page</a>
				<a class="btn btn-secondary" href="/contact/">Request a Consultation</a>
			</div>
		</div>
	</section>
</BaseLayout>
