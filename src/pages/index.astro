---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
	'We are deploying our updated digital infrastructure. Meridian Integrations engineers high-performance networking, structural security, and automation systems designed to vanish into premium spaces.';
---

<BaseLayout
	title="Meridian Integrations | Infrastructure & Automation"
	fullTitle="Meridian Integrations | Infrastructure & Automation"
	description={description}
	standalone
>
  <main id="main" class="relative w-full min-h-screen bg-[var(--color-background)] flex flex-col justify-between pt-32 pb-16 px-6 md:px-12">
    
    <!-- Top Branding Anchor -->
    <div class="max-w-6xl mx-auto w-full">
      <span class="text-xs font-bold tracking-widest text-[var(--color-accent)] uppercase">
        Meridian Integrations
      </span>
    </div>

    <!-- Main Central Statement -->
    <div class="max-w-6xl mx-auto w-full flex-grow flex flex-col justify-center my-auto">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-6 leading-tight">
          Systems Architecture.<br /> Currently Tuning.
        </h1>
        <p class="text-lg md:text-xl text-[var(--color-text-muted)] font-normal leading-relaxed mb-8">
          We are deploying our updated digital infrastructure. Meridian Integrations engineers high-performance networking, structural security, and automation systems designed to vanish into premium spaces.
        </p>
        <div class="inline-flex items-center gap-2 border border-[var(--color-border)] px-4 py-2 rounded bg-white/5 backdrop-blur-sm">
          <span class="w-2 h-2 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
          <span class="text-xs font-mono text-[var(--color-text-muted)] uppercase tracking-wider">
            Site Launch Imminent
          </span>
        </div>
      </div>
    </div>

    <!-- Bottom Contact Intake Anchor -->
    <div class="max-w-6xl mx-auto w-full border-t border-[var(--color-border)] pt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <p class="text-xs font-bold text-[var(--color-text)] uppercase tracking-wider mb-1">Architectural Intake</p>
        <p class="text-sm text-[var(--color-text-muted)]">Active project consultations remain uninterrupted.</p>
      </div>
      <a href="mailto:info@meridianintegrations.com" class="text-xs font-bold text-[var(--color-accent)] no-underline hover:text-[var(--color-accent-bright)] transition-colors duration-200 uppercase tracking-widest border-b border-[var(--color-accent)] pb-0.5">
        Initiate Consultation &rarr;
      </a>
    </div>

  </main>
</BaseLayout>
