---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
	'We eliminate low-voltage trade friction, handle complex load calculations, and integrate invisible infrastructure seamlessly into your architectural plans.';
---

<BaseLayout
	title="Trade Partners | Meridian Integrations"
	fullTitle="Trade Partners | Meridian Integrations"
	description={description}
>
  <div class="w-full bg-[var(--color-background)] pt-24 pb-16 md:pt-32 md:pb-24">
    <div class="max-w-5xl mx-auto px-6 md:px-12">
      
      <!-- Page Hero Header -->
      <div class="max-w-3xl mb-16 md:mb-24">
        <span class="text-xs font-bold tracking-widest text-[var(--color-accent)] uppercase block mb-3">
          B2B Trade Program
        </span>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-6 leading-tight">
          Become a Smart Home Builder Partner.
        </h1>
        <p class="text-lg md:text-xl text-[var(--color-text-muted)] font-normal leading-relaxed">
          We eliminate low-voltage trade friction, handle complex load calculations, and integrate invisible infrastructure seamlessly into your architectural plans.
        </p>
      </div>

      <!-- Core Partnership Benefits Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 border-t border-[var(--color-border)] pt-12">
        
        <!-- Benefit 1: Capitalization -->
        <div>
          <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">Elevate Project Capitalization</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Increase the overall valuation and margin of your builds with zero additional sales friction or engineering overhead. 
          </p>
        </div>

        <!-- Benefit 2: Advisory Integration -->
        <div>
          <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">Seamless Advisory Integration</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Our systems engineers consult directly with your client or interior design team during the blueprint phase. We handle the complex tracking required for advanced automation ecosystems, letting your team capture the revenue of an elite smart estate effortlessly.
          </p>
        </div>

        <!-- Benefit 3: Single Point of Contact -->
        <div>
          <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">Single Point of Contact</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Your field project managers coordinate with one dedicated systems engineer. We eliminate trade-coordination gaps, finger-pointing, and communication breakdowns entirely.
          </p>
        </div>

        <!-- Benefit 4: Blueprint & CAD Overlays -->
        <div>
          <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">Blueprint & CAD Overlays</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Provide us with your electronic architectural layouts. We deliver comprehensive low-voltage design overlays, pathway diagrams, and conduit route maps integrated into your master building plans before a single wire is pulled.
          </p>
        </div>

        <!-- Benefit 5: Documentation Standards -->
        <div>
          <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">Rigid Documentation Standards</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            We deploy documentation-grade wiring infrastructure. Every low-voltage and high-amperage line is computer-labeled, source-mapped, and completely organized within standard-compliant enclosures.
          </p>
        </div>

        <!-- Benefit 6: Flawless Inspection History -->
        <div>
          <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">Flawless Inspection History</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Our installations comply meticulously with NAHB guidelines and CEDIA advanced wiring protocols. We protect your critical path scheduling by ensuring zero inspection adjustments.
          </p>
        </div>

      </div>

      <!-- Action Intake Footer -->
      <div class="mt-20 border-t border-[var(--color-border)] pt-12 max-w-2xl">
        <h3 class="text-xl font-bold text-[var(--color-text)] mb-3">Initiate a Blueprint Consultation</h3>
        <p class="text-sm text-[var(--color-text-muted)] mb-6">
          Do not let low-voltage planning become a punch-list emergency. Connect with our engineering team during the pre-con or rough-in phase to ensure flawless cosmetic integration.
        </p>
        <a href="mailto:info@meridianintegrations.com" class="text-xs font-bold text-[var(--color-accent)] no-underline hover:text-[var(--color-accent-bright)] transition-colors duration-200 uppercase tracking-widest border-b border-[var(--color-accent)] pb-0.5 inline-block">
          Request Builder Integration Intake &rarr;
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
