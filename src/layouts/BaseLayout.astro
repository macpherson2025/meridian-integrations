---
import "../styles/global.css";
import BaseHead from "../components/basehead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import { site, absoluteUrl } from "../config/site";
import { businessNode, websiteNode, webPageNode } from "../config/schema";
import sansFont from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2";

interface Props {
	title: string;
	description: string;
	/** Full document title. When omitted, the site name is appended. */
	fullTitle?: string;
	path?: string;
	noindex?: boolean;
	ogImage?: string;
	extraSchema?: Record<string, unknown>[];
	/** Omit the site header, footer, and outer main. The page supplies its own landmark. */
	standalone?: boolean;
}

const {
	title,
	description,
	fullTitle,
	path = Astro.url.pathname,
	noindex = false,
	ogImage = "https://www.meridianintegrations.com/og.png",
	extraSchema = [],
	standalone = false,
} = Astro.props;

const documentTitle = fullTitle ?? `${title} | ${site.name}`;
const canonical = absoluteUrl(path);
const graph = {
	"@context": "https://schema.org",
	"@graph": [
		websiteNode(),
		businessNode(),
		webPageNode({ title: documentTitle, description, path }),
		...extraSchema,
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={documentTitle}
			description={description}
			image={ogImage}
			robots={noindex ? "noindex, follow" : undefined}
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#202321" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link
			rel="preload"
			href={sansFont}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<JsonLd data={graph} />
		<!-- Google Business Profile LocalBusiness Schema -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "LocalBusiness",
				"name": "Meridian Integrations",
				"image": "https://www.meridianintegrations.com/og.png",
				"@id": "https://www.meridianintegrations.com/#url",
				"url": "https://www.meridianintegrations.com/",
				"telephone": "720-989-9807",
				"priceRange": "$$$$",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Denver",
					"addressRegion": "CO",
					"addressCountry": "US"
				},
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": 39.7392,
					"longitude": -104.9903
				},
				"areaServed": [
					"Denver", "Boulder", "Cherry Hills Village", "Greenwood Village",
					"Castle Pines", "Golden", "Highlands Ranch", "Louisville", "Lafayette", "Longmont"
				],
				"serviceArea": {
					"@type": "GeoCircle",
					"geoMidpoint": {
						"@type": "GeoCoordinates",
						"latitude": 39.7392,
						"longitude": -104.9903
					},
					"geoRadius": "50000"
				},
				"hasOfferCatalog": {
					"@type": "OfferCatalog",
					"name": "Infrastructure and Automation Services",
					"itemListElement": [
						{
							"@type": "Offer",
							"itemOffered": {
								"@type": "Service",
								"name": "UniFi Network & Security Solutions"
							}
						},
						{
							"@type": "Offer",
							"itemOffered": {
								"@type": "Service",
								"name": "Lutron Architectural Lighting & Motorized Shades"
							}
						},
						{
							"@type": "Offer",
							"itemOffered": {
								"@type": "Service",
								"name": "High-Amperage EV Charger Installation"
							}
						}
					]
				}
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		{standalone ? (
			<slot />
		) : (
			<>
				<Header />
				<main id="main">
					<slot />
				</main>
				<Footer />
			</>
		)}
	</body>
</html>
